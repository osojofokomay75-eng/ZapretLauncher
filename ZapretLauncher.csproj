<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 is built into Windows 10/11: the exe is tiny and needs no runtime install -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ZapretLauncher</AssemblyName>
    <RootNamespace>ZapretLauncher</RootNamespace>
    <Version>1.2.6</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- JSON for the Telegram proxy config; System.Web is only here because the XAML compiler resolves it through Extensions -->
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icon for "bypass off"; the "on" icon is app.ico itself -->
    <EmbeddedResource Include="app-off.ico" LogicalName="app-off.ico" />
  </ItemGroup>

  <!-- The installer is this same exe under another name: started as *Setup.exe it runs the setup wizard -->
  <Target Name="CopySetup" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)ZapretLauncherSetup.exe" SkipUnchangedFiles="true" />
  </Target>

</Project>
