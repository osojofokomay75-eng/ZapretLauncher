<Window x:Class="ZapretLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZapretLauncher"
        Title="Zapret Launcher" Width="1152" Height="826" MinWidth="1060" MinHeight="720"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#050505" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- Opaque window with a client-drawn frame. A layered (AllowsTransparency) window is copied back
         from the GPU on every frame, which made dragging stutter while the sky is animating -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Palette: black sky, panels of frosted glass (see Frost below). Signal is the accent - white unless
             Settings say otherwise - so it is always referenced dynamically; SignalSoft is its quieter shade. -->
        <SolidColorBrush x:Key="Ink" Color="#0A0A0A" />
        <SolidColorBrush x:Key="Line" Color="#222222" />
        <SolidColorBrush x:Key="Text" Color="#F2F2F2" />
        <SolidColorBrush x:Key="Muted" Color="#9A9A9A" />
        <SolidColorBrush x:Key="Faint" Color="#6B6B6B" />
        <SolidColorBrush x:Key="Signal" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SignalSoft" Color="#A3A3A3" />
        <Color x:Key="SignalColor">#FFFFFF</Color>
        <SolidColorBrush x:Key="Edge" Color="#24FFFFFF" />

        <!-- Backdrop; also painted under the glass, so panels read as see-through rather than filled -->
        <RadialGradientBrush x:Key="Space" Center="0.5,0.25" GradientOrigin="0.5,0.25" RadiusX="0.8" RadiusY="0.9">
            <GradientStop Color="#121212" Offset="0" />
            <GradientStop Color="#030303" Offset="1" />
        </RadialGradientBrush>

        <!-- Laid over every piece of frosted glass; the blur itself is made in code, its strength is a setting -->
        <SolidColorBrush x:Key="Veil" Color="#12FFFFFF" />

        <!-- Frosted panel: the blur itself is drawn by the Frost layer behind it -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="local:Glass.Radius" Value="16" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Invisible button laid over the power disc -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="local:Glass.Radius" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#52FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action (setup wizard) -->
        <Style x:Key="PillSolid" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Foreground" Value="#0A0A0A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#DEDEDE" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text field (setup wizard) -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text}" />
            <Setter Property="SelectionBrush" Value="#FFFFFF" />
            <Setter Property="SelectionOpacity" Value="0.3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="#14FFFFFF" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab in the title bar. The open one is underlined with the same kind of bar that marks the chosen
             strategy; that bar is a single one, beside the tabs, and slides to whichever is chosen (TabBar).
             The dot beside the name, the size of the pointer's, is lit from code while that tab's service is running. -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="12,9,12,12" HorizontalAlignment="Center" />
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Signal}" Opacity="0" IsHitTestVisible="False"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-4,2">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{DynamicResource SignalColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.75" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider (Settings): a thin line, filled with the accent up to the thumb -->
        <Style x:Key="SlideSide" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="20">
                            <Border Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlideThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="16" Height="20" Background="Transparent">
                            <Ellipse Width="14" Height="14" Fill="{DynamicResource Signal}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Slide" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SlideSide}" Background="{DynamicResource Signal}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SlideSide}" Background="#24FFFFFF" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlideThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent colour to choose (Settings): the dot is the colour, the ring marks the chosen one -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="GroupName" Value="Accent" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="26" Height="26" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{TemplateBinding Background}" StrokeThickness="1.5" Opacity="0" />
                            <Ellipse Width="16" Height="16" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact pill for the footer tray -->
        <Style x:Key="PillSmall" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="11,4" />
        </Style>

        <!-- Clickable text: no chrome, it just brightens under the pointer -->
        <Style x:Key="Bare" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Window buttons -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Strategy list. The stock template paints a disabled list white; this one just dims it -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="Scroll" Focusable="False" Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                            <ItemsPresenter />
                        </ScrollViewer>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Scroll" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Strategy rows: the selected row gets a signal bar on the left; rows the auto-pick found working get a tick -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Padding="18,9,18,9" Margin="6,1,6,1" Background="Transparent">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="-16,0,0,0" Background="{DynamicResource Signal}" Visibility="Hidden" />
                                <ContentPresenter HorizontalAlignment="Center" TextElement.FontSize="13.5" />
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{StaticResource Text}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,-4,0" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- first, so that hover and selection still win over it -->
                            <DataTrigger Binding="{Binding Works}" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Grid x:Name="Knob" Grid.Column="1" Width="40" Height="22">
                                <Grid.RenderTransform>
                                    <TranslateTransform />
                                </Grid.RenderTransform>
                                <!-- Halo: a soft grey ellipse with the track cut out of it, so it only shows around the switch -->
                                <Canvas IsHitTestVisible="False">
                                    <Path x:Name="Halo" Opacity="0">
                                        <Path.Data>
                                            <CombinedGeometry GeometryCombineMode="Exclude">
                                                <CombinedGeometry.Geometry1>
                                                    <EllipseGeometry Center="20,11" RadiusX="58" RadiusY="48" />
                                                </CombinedGeometry.Geometry1>
                                                <CombinedGeometry.Geometry2>
                                                    <RectangleGeometry Rect="0,0,40,22" RadiusX="11" RadiusY="11" />
                                                </CombinedGeometry.Geometry2>
                                            </CombinedGeometry>
                                        </Path.Data>
                                        <Path.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#70909090" Offset="0" />
                                                <GradientStop Color="#45909090" Offset="0.3" />
                                                <GradientStop Color="#20909090" Offset="0.55" />
                                                <GradientStop Color="#0A909090" Offset="0.8" />
                                                <GradientStop Color="#00909090" Offset="1" />
                                            </RadialGradientBrush>
                                        </Path.Fill>
                                    </Path>
                                </Canvas>
                                <!-- The track has a round hole where the thumb sits, so the thumb is the card's own
                                     frosted glass showing through; one track per position -->
                                <Path x:Name="TrackOff" Fill="#1FFFFFFF">
                                    <Path.Data>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <RectangleGeometry Rect="0,0,40,22" RadiusX="11" RadiusY="11" />
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <EllipseGeometry Center="11,11" RadiusX="8" RadiusY="8" />
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Path.Data>
                                </Path>
                                <Path x:Name="TrackOn" Fill="{DynamicResource SignalSoft}" Visibility="Collapsed">
                                    <Path.Data>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <RectangleGeometry Rect="0,0,40,22" RadiusX="11" RadiusY="11" />
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <EllipseGeometry Center="29,11" RadiusX="8" RadiusY="8" />
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Path.Data>
                                </Path>
                                <Ellipse x:Name="Thumb" Width="16" Height="16"
                                         HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TrackOff" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="TrackOn" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Shell">
        <Rectangle Fill="{StaticResource Space}" />

        <!-- The picture behind everything - the launcher's own or the user's (Settings) - dimmed and, if asked,
             blurred. It is wider than the window and tiled as mirror images, so a blur has picture to take in
             at the edges instead of fading out there. -->
        <Grid x:Name="Wallpaper" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid x:Name="WallpaperHost" Margin="-130">
                <Rectangle x:Name="WallpaperBox" />
            </Grid>
            <Rectangle x:Name="WallpaperDim" />
        </Grid>

        <!-- Drifting stars; the layers are filled in code -->
        <Canvas x:Name="Sky" IsHitTestVisible="False" ClipToBounds="True" />

        <!-- Frosted glass: the backdrop again, a blurred copy of the sky (or of the picture) and a light veil,
             clipped in code to every element with Glass.Radius. The blurred copies are drawn at reduced
             resolution - a heavy blur hides the upscaling and costs a fraction; code sets the scale. -->
        <Grid x:Name="Frost" IsHitTestVisible="False">
            <Rectangle Fill="{StaticResource Space}" />
            <Grid x:Name="FrostSkyHost">
                <Grid x:Name="FrostSky" />
            </Grid>
            <Grid x:Name="FrostWallpaper" Visibility="Collapsed">
                <Grid x:Name="FrostWallpaperHost" Margin="-130">
                    <Rectangle x:Name="FrostWallpaperBox" />
                </Grid>
                <Rectangle x:Name="FrostWallpaperDim" />
            </Grid>
            <Rectangle Fill="{StaticResource Veil}" />
        </Grid>

        <Grid x:Name="MainView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="44" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal">
                        <RadioButton x:Name="TabZapret" Content="Zapret" Style="{StaticResource Tab}" IsChecked="True" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabProxy" Content="TG WS Proxy" Style="{StaticResource Tab}" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabSettings" Content="Настройки" Style="{StaticResource Tab}" Checked="Tab_Checked" />
                    </StackPanel>
                    <!-- The underline of the open tab; code slides it under the tab that is chosen -->
                    <Border x:Name="TabBar" Width="18" Height="3" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="0,0,0,4" Background="{DynamicResource Signal}" IsHitTestVisible="False" Opacity="0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="TabBarAt" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Style="{StaticResource TitleBtn}" Content="&#xE921;" Click="Min_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBtn}" Content="&#xE922;" Click="Max_Click" />
                    <Button Style="{StaticResource TitleBtn}" Content="&#xE8BB;" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Zapret tab: a large power button in the middle; the strategies open in a window of their own
                 (ModalLayer), everything to tune is on the Settings tab -->
            <Grid x:Name="ZapretView" Grid.Row="1">
                <!-- the button sits in the very middle; what goes with it hangs below -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Width="150" Height="150" HorizontalAlignment="Center">
                    <!-- drawn at its old size and enlarged whole, corona and all -->
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="2.3" ScaleY="2.3" />
                    </Grid.LayoutTransform>
                    <!-- A disc of the same frosted glass as the panels, with a corona of the accent colour around it.
                         The corona is two blurred discs, a tight bright one and a wide faint one; each is drawn
                         once into a bitmap, and code only fades and swells those (see Tint). The glyph is a
                         lighter, see-through tint of the glass and does not take the accent. -->
                    <Canvas IsHitTestVisible="False">
                        <!-- the corona is only seen around the disc: the disc itself is glass, not a lid -->
                        <Canvas.Clip>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="-110,-110,370,370" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry Center="75,75" RadiusX="61.5" RadiusY="61.5" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Canvas.Clip>
                        <Grid x:Name="HaloOut" Width="340" Height="340" Canvas.Left="-95" Canvas.Top="-95" Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.CacheMode>
                                <BitmapCache RenderAtScale="0.5" />
                            </Grid.CacheMode>
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Ellipse Width="152" Height="152" Fill="{DynamicResource Signal}">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="80" RenderingBias="Performance" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <Grid x:Name="HaloIn" Width="340" Height="340" Canvas.Left="-95" Canvas.Top="-95" Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.CacheMode>
                                <BitmapCache RenderAtScale="0.5" />
                            </Grid.CacheMode>
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Ellipse Width="136" Height="136" Fill="{DynamicResource Signal}">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="36" RenderingBias="Performance" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Canvas>
                    <Ellipse x:Name="Disc" Width="124" Height="124" Fill="#3D000000" local:Glass.Radius="999" />
                    <Ellipse x:Name="Ring" Width="124" Height="124" StrokeThickness="1">
                        <Ellipse.Stroke>
                            <SolidColorBrush Color="#33FFFFFF" />
                        </Ellipse.Stroke>
                    </Ellipse>
                    <Viewbox Width="46" Height="46" IsHitTestVisible="False">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="PowerIcon" Data="M18.36,6.64 A9,9 0 1 1 5.63,6.64 M12,2 L12,12"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                <Path.Stroke>
                                    <SolidColorBrush Color="#47FFFFFF" />
                                </Path.Stroke>
                            </Path>
                        </Canvas>
                    </Viewbox>
                    <Button x:Name="PowerButton" Style="{StaticResource Ghost}" Width="124" Height="124"
                            Click="Power_Click" />
                </Grid>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock x:Name="StatusText" Text="Отключено" FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{StaticResource Text}" />
                    <TextBlock x:Name="SubText" Text="Нажмите, чтобы включить" FontSize="13" MaxWidth="520"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{StaticResource Muted}" />
                    <Button x:Name="StrategiesButton" Style="{StaticResource Pill}" Padding="16,8" Margin="0,18,0,0" HorizontalAlignment="Center"
                            Click="Strategies_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4DC;" FontFamily="Segoe UI Emoji" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,1" />
                            <TextBlock Text="Список стратегий" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding SelectedItem.Name, ElementName=StrategyList}" FontSize="12" MaxWidth="420"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{StaticResource Faint}" />
                </StackPanel>
            </Grid>

            <!-- TG WS Proxy tab: laid out like the zapret tab (ProxyTab.cs). How to connect Telegram is told in a
                 window of its own (ModalLayer). Nothing has to be filled in: address, port and key are the proxy's
                 own defaults and live in its config.json; its switches are on the Settings tab. -->
            <Grid x:Name="ProxyView" Grid.Row="1" Visibility="Collapsed">
                <!-- the button sits in the very middle; what goes with it hangs below -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Width="150" Height="150" HorizontalAlignment="Center">
                    <!-- drawn at its old size and enlarged whole, corona and all -->
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="2.3" ScaleY="2.3" />
                    </Grid.LayoutTransform>
                    <Canvas IsHitTestVisible="False">
                        <!-- the corona is only seen around the disc: the disc itself is glass, not a lid -->
                        <Canvas.Clip>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="-110,-110,370,370" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry Center="75,75" RadiusX="61.5" RadiusY="61.5" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Canvas.Clip>
                        <Grid x:Name="PxHaloOut" Width="340" Height="340" Canvas.Left="-95" Canvas.Top="-95" Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.CacheMode>
                                <BitmapCache RenderAtScale="0.5" />
                            </Grid.CacheMode>
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Ellipse Width="152" Height="152" Fill="{DynamicResource Signal}">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="80" RenderingBias="Performance" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <Grid x:Name="PxHaloIn" Width="340" Height="340" Canvas.Left="-95" Canvas.Top="-95" Opacity="0"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.CacheMode>
                                <BitmapCache RenderAtScale="0.5" />
                            </Grid.CacheMode>
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Ellipse Width="136" Height="136" Fill="{DynamicResource Signal}">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="36" RenderingBias="Performance" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Canvas>
                    <Ellipse x:Name="PxDisc" Width="124" Height="124" Fill="#3D000000" local:Glass.Radius="999" />
                    <Ellipse x:Name="PxRing" Width="124" Height="124" StrokeThickness="1">
                        <Ellipse.Stroke>
                            <SolidColorBrush Color="#33FFFFFF" />
                        </Ellipse.Stroke>
                    </Ellipse>
                    <Viewbox Width="46" Height="46" IsHitTestVisible="False">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="PxIcon" Data="M18.36,6.64 A9,9 0 1 1 5.63,6.64 M12,2 L12,12"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                <Path.Stroke>
                                    <SolidColorBrush Color="#47FFFFFF" />
                                </Path.Stroke>
                            </Path>
                        </Canvas>
                    </Viewbox>
                    <Button x:Name="PxPower" Style="{StaticResource Ghost}" Width="124" Height="124"
                            Click="PxPower_Click" />
                </Grid>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock x:Name="PxStatus" Text="Отключено" FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{StaticResource Text}" />
                    <TextBlock x:Name="PxSub" Text="Нажмите, чтобы включить прокси для Telegram" FontSize="13" MaxWidth="520"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{StaticResource Muted}" />
                    <Button x:Name="ProxyInfoButton" Style="{StaticResource Pill}" Padding="16,8" Margin="0,18,0,0" HorizontalAlignment="Center"
                            Click="ProxyInfo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,1,9,0" />
                            <TextBlock Text="Информация" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Settings tab: everything there is to tune - the bypass, the proxy, the program itself and its looks
                 (SettingsTab.cs). The switches are the same controls the other tabs used to carry. -->
            <Grid x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" Margin="24,6,24,8" MaxWidth="1320">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" Padding="20,14,20,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Zapret" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,0,0,3" />
                            <CheckBox x:Name="GameToggle" Style="{StaticResource Switch}" Click="Game_Click" Margin="0,9">
                                <StackPanel>
                                    <TextBlock Text="Игровой фильтр" FontSize="14" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="Обход для игровых портов 1024–65535" FontSize="12"
                                               Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Margin="0,9,0,6">
                                <TextBlock Text="Свои списки" FontSize="14" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Наведите на кнопку, чтобы узнать, зачем она" FontSize="12"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <UniformGrid Rows="1" Margin="-4,0">
                                <Button Content="Мои сайты" Tag="list-general-user.txt" Style="{StaticResource Pill}" Padding="6,6"
                                        Margin="4" Click="UserList_Click"
                                        local:Hint.Text="list-general-user.txt — сайты, которые нужно разблокировать дополнительно.&#x0a;&#x0a;Кому нужно: если сайт заблокирован и не открывается даже с включённым обходом.&#x0a;&#x0a;Что делать: впишите домены по одному в строке, например example.com — без https:// и без пути. Поддомены подхватятся сами. Не оставляйте файл пустым.&#x0a;&#x0a;После сохранения выключите и включите обход." />
                                <Button Content="Исключения" Tag="list-exclude-user.txt" Style="{StaticResource Pill}" Padding="6,6"
                                        Margin="4" Click="UserList_Click"
                                        local:Hint.Text="list-exclude-user.txt — сайты, которые обход трогать не должен.&#x0a;&#x0a;Кому нужно: если с включённым обходом перестал работать обычный сайт или сервис — банк, игра, рабочий портал.&#x0a;&#x0a;Что делать: впишите домены по одному в строке, например example.com.&#x0a;&#x0a;После сохранения выключите и включите обход." />
                                <Button Content="Исключения IP" Tag="ipset-exclude-user.txt" Style="{StaticResource Pill}" Padding="6,6"
                                        Margin="4" Click="UserList_Click"
                                        local:Hint.Text="ipset-exclude-user.txt — IP-адреса и подсети, которые обход трогать не должен.&#x0a;&#x0a;Кому нужно: опытным пользователям — когда ломается то, у чего нет доменного имени: игровой сервер, VPN, устройство в домашней сети.&#x0a;&#x0a;Что делать: впишите адреса по одному в строке, например 192.168.0.0/16 или 203.0.113.5.&#x0a;&#x0a;После сохранения выключите и включите обход." />
                                <Button Content="Папка lists" Style="{StaticResource Pill}" Padding="6,6"
                                        Margin="4" Click="ListsFolder_Click"
                                        local:Hint.Text="Открывает папку со всеми списками zapret.&#x0a;&#x0a;Кому нужно: тем, кто хочет посмотреть, какие сайты и адреса уже входят в обход, или подложить готовый список.&#x0a;&#x0a;Важно: основные файлы (list-general.txt, ipset-all.txt и другие) перезаписываются при обновлении компонентов. Свои правки вносите только в файлы с user в названии — они сохраняются." />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,14,20,12">
                        <StackPanel>
                            <TextBlock Text="Прокси Telegram" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,0,0,3" />
                            <CheckBox x:Name="PxCf" Style="{StaticResource Switch}" Click="PxSwitch_Click" Margin="0,9">
                                <StackPanel>
                                    <TextBlock Text="Резерв через Cloudflare" FontSize="14" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="Если прямой путь к Telegram закрыт" FontSize="12"
                                               Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="PxH2" Style="{StaticResource Switch}" Click="PxSwitch_Click" Margin="0,9">
                                <StackPanel>
                                    <TextBlock Text="Ускорение медиа" FontSize="14" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="Фото и видео по HTTP/2 через Cloudflare" FontSize="12"
                                               Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="PxAuto" Style="{StaticResource Switch}" Click="PxAuto_Click" Margin="0,9">
                                <StackPanel>
                                    <TextBlock Text="Включать с лаунчером" FontSize="14" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="Прокси стартует сам при запуске" FontSize="12"
                                               Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <UniformGrid Rows="1" Margin="-4,5,-4,0">
                                <Button x:Name="PxMedia" Content="Не грузятся медиа" Style="{StaticResource Pill}"
                                        Margin="4" Click="PxMedia_Click"
                                        local:Hint.Text="Переключает способ, которым прокси соединяется с серверами Telegram (таблицу DC → IP), и перезапускает его.&#x0a;&#x0a;Кому нужно: если сообщения через прокси ходят, а фото и видео не загружаются.&#x0a;&#x0a;Способов три, каждое нажатие включает следующий по кругу. Нажали — проверьте Telegram; не помогло — нажмите ещё раз." />
                                <Button Content="Логи" Style="{StaticResource Pill}"
                                        Margin="4" Click="PxLogs_Click"
                                        local:Hint.Text="Открывает журнал прокси в Блокноте.&#x0a;&#x0a;Кому нужно: если Telegram не соединяется — причина обычно написана в последних строках. Журнал начинается заново при каждом запуске прокси." />
                                <Button Content="Папка" Style="{StaticResource Pill}"
                                        Margin="4" Click="PxFolder_Click"
                                        local:Hint.Text="Открывает папку, где лежат TG WS Proxy и его настройки.&#x0a;&#x0a;Кому нужно: тем, кто хочет поправить файл TgWsProxy_data\config.json вручную — в нём адрес, порт, ключ и остальные настройки прокси, которых нет на этой вкладке." />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="20,14,20,8" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Приложение" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,0,0,3" />
                            <CheckBox x:Name="CloseToggle" Style="{StaticResource Switch}" Click="CloseToTray_Click" Margin="0,9">
                                <StackPanel>
                                    <TextBlock Text="Сворачивать в трей" FontSize="14" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="Закрытие окна не завершает программу" FontSize="12"
                                               Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="AutostartToggle" Style="{StaticResource Switch}" Click="Autostart_Click" Margin="0,9">
                                <StackPanel>
                                    <TextBlock Text="Запускать вместе с Windows" FontSize="14" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="Включается сам, в трее и без запроса UAC" FontSize="12"
                                               Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,14,20,14">
                        <StackPanel>
                            <TextBlock Text="Оформление" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,0,0,3" />
                            <Grid Margin="0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Фон" FontSize="14" Foreground="{StaticResource Text}" />
                                    <TextBlock x:Name="BgName" Text="Стандартный" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Выбрать…" Style="{StaticResource Pill}" Click="BgPick_Click"
                                            local:Hint.Text="Ставит фоном окна вашу картинку: она растягивается на всё окно, лишнее по краям обрезается.&#x0a;&#x0a;Подходят JPG, PNG, BMP, GIF и TIFF. Лаунчер хранит свою копию картинки, исходный файл можно потом удалить или переместить." />
                                    <Button Content="Стандартный" Style="{StaticResource Pill}" Margin="8,0,0,0" Click="BgReset_Click" />
                                    <Button Content="Звёзды" Style="{StaticResource Pill}" Margin="8,0,0,0" Click="BgStars_Click" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Яркость фона" FontSize="14" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="BrightSlider" Style="{StaticResource Slide}" Width="170" Minimum="0" Maximum="100"
                                            LargeChange="10" SmallChange="1" Value="50" ValueChanged="Bright_Changed"
                                            local:Hint.Text="Насколько светлой остаётся картинка на фоне: 100% — как есть, меньше — темнее.&#x0a;&#x0a;На тёмном фоне текст читается лучше. На звёзды не действует." />
                                    <TextBlock x:Name="BrightValue" Text="50%" Width="40" TextAlignment="Right" FontSize="12.5"
                                               VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Размытие фона" FontSize="14" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="BgBlurSlider" Style="{StaticResource Slide}" Width="170" Minimum="0" Maximum="100"
                                            LargeChange="10" SmallChange="1" Value="0" ValueChanged="BgBlur_Changed"
                                            local:Hint.Text="Размывает саму картинку на фоне — всю, а не только под панелями.&#x0a;&#x0a;На звёзды не действует." />
                                    <TextBlock x:Name="BgBlurValue" Text="0%" Width="40" TextAlignment="Right" FontSize="12.5"
                                               VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Размытие стекла" FontSize="14" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="BlurSlider" Style="{StaticResource Slide}" Width="170" Minimum="0" Maximum="100"
                                            LargeChange="10" SmallChange="1" Value="60" ValueChanged="Blur_Changed"
                                            local:Hint.Text="Насколько панели и кнопка включения размывают фон под собой: 0 — прозрачное стекло." />
                                    <TextBlock x:Name="BlurValue" Text="60%" Width="40" TextAlignment="Right" FontSize="12.5"
                                               VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,9,0,0">
                                <TextBlock Text="Акцентный цвет" FontSize="14" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Кнопка включения, индикаторы, переключатели, выделение в списках" FontSize="12"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <!-- The palette: across the square the colour gains saturation, down it loses brightness;
                                 the strip beside it picks the hue. Swatches and the field are shortcuts into it. -->
                            <Grid Margin="0,12,0,0" Height="118">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="SvBox" Background="Transparent" Cursor="Hand" SizeChanged="Palette_SizeChanged"
                                      MouseLeftButtonDown="Sv_Down" MouseMove="Sv_Move" MouseLeftButtonUp="Palette_Up">
                                    <Rectangle x:Name="SvHue" RadiusX="9" RadiusY="9" Fill="#FF0000" />
                                    <Rectangle RadiusX="9" RadiusY="9">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle RadiusX="9" RadiusY="9" Stroke="{StaticResource Edge}" StrokeThickness="1">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Canvas IsHitTestVisible="False">
                                        <Ellipse x:Name="SvMark" Width="14" Height="14" Stroke="#FFFFFF" StrokeThickness="2">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.9" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Canvas>
                                </Grid>
                                <Grid x:Name="HueBox" Grid.Column="2" Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Palette_Up">
                                    <Rectangle RadiusX="7" RadiusY="7">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF0000" Offset="0" />
                                                <GradientStop Color="#FFFF00" Offset="0.1667" />
                                                <GradientStop Color="#00FF00" Offset="0.3333" />
                                                <GradientStop Color="#00FFFF" Offset="0.5" />
                                                <GradientStop Color="#0000FF" Offset="0.6667" />
                                                <GradientStop Color="#FF00FF" Offset="0.8333" />
                                                <GradientStop Color="#FF0000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Canvas IsHitTestVisible="False">
                                        <Rectangle x:Name="HueMark" Width="20" Height="5" Canvas.Left="-3" RadiusX="2.5" RadiusY="2.5" Fill="#FFFFFF">
                                            <Rectangle.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.9" />
                                            </Rectangle.Effect>
                                        </Rectangle>
                                    </Canvas>
                                </Grid>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <UniformGrid x:Name="AccentSwatches" Columns="4" Margin="0,0,-7,0">
                                    <RadioButton Style="{StaticResource Swatch}" Margin="0,0,7,6" Background="#FFFFFF" Checked="Accent_Checked" />
                                    <RadioButton Style="{StaticResource Swatch}" Margin="0,0,7,6" Background="#7AB8FF" Checked="Accent_Checked" />
                                    <RadioButton Style="{StaticResource Swatch}" Margin="0,0,7,6" Background="#5EEAD4" Checked="Accent_Checked" />
                                    <RadioButton Style="{StaticResource Swatch}" Margin="0,0,7,6" Background="#86EFAC" Checked="Accent_Checked" />
                                    <RadioButton Style="{StaticResource Swatch}" Margin="0,0,7,6" Background="#FDE047" Checked="Accent_Checked" />
                                    <RadioButton Style="{StaticResource Swatch}" Margin="0,0,7,6" Background="#FDBA74" Checked="Accent_Checked" />
                                    <RadioButton Style="{StaticResource Swatch}" Margin="0,0,7,6" Background="#FB7185" Checked="Accent_Checked" />
                                    <RadioButton Style="{StaticResource Swatch}" Margin="0,0,7,6" Background="#C4B5FD" Checked="Accent_Checked" />
                                    </UniformGrid>
                                    <TextBox x:Name="AccentHex" Style="{StaticResource Field}" Margin="0,6,0,0" MaxLength="7"
                                             LostFocus="AccentHex_LostFocus" KeyDown="AccentHex_KeyDown"
                                             local:Hint.Text="Свой цвет: шесть шестнадцатеричных цифр, например #7AB8FF, и Enter.&#x0a;&#x0a;Интерфейс тёмный, поэтому светлые и яркие цвета видны лучше тёмных." />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Footer: the version line pulls out a tray of actions; messages fade in under it (see Log) -->
            <StackPanel Grid.Row="2" Margin="24,0,24,8">
                <ProgressBar x:Name="DownloadBar" Height="3" Visibility="Collapsed" Minimum="0" Maximum="100"
                             Background="#24FFFFFF" Foreground="{DynamicResource Signal}" BorderThickness="0"
                             Margin="0,6,0,0" />
                <Grid Height="52">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="VersionShift" />
                        </StackPanel.RenderTransform>
                        <Button x:Name="TrayToggle" Style="{StaticResource Bare}" Padding="0,5" Click="Tray_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="VersionText" FontSize="12" VerticalAlignment="Center" />
                                <Path x:Name="TrayChevron" Data="M0,0 L4,4 L0,8" StrokeThickness="1.4" Opacity="0.75" Margin="9,1,2,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="TrayArrow" />
                                    </Path.RenderTransform>
                                </Path>
                            </StackPanel>
                        </Button>
                        <!-- The canvas is the tray's window: it opens by growing wide enough to show the buttons -->
                        <Canvas x:Name="TrayClip" ClipToBounds="True" Width="0" Height="26" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel x:Name="Tray" Orientation="Horizontal" Canvas.Left="-18" Opacity="0">
                                <Button x:Name="UpdateButton" Content="Обновить" Style="{StaticResource PillSmall}"
                                        Click="Update_Click" Margin="0,0,8,0" />
                                <Button Content="Папка" Style="{StaticResource PillSmall}" Click="Folder_Click" />
                            </StackPanel>
                        </Canvas>
                    </StackPanel>
                    <Button x:Name="LogButton" Style="{StaticResource Bare}" Padding="0,3" Click="Tray_Click"
                            HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="1000"
                            Opacity="0" IsHitTestVisible="False">
                        <Button.RenderTransform>
                            <TranslateTransform Y="11" />
                        </Button.RenderTransform>
                        <TextBlock x:Name="LogText" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Setup wizard: replaces the main view when the exe runs as the installer or uninstaller (Setup.cs) -->
        <Grid x:Name="SetupView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Height="44" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Zapret" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock Text=" Launcher" FontSize="15" Foreground="{StaticResource Faint}" />
                    <TextBlock x:Name="SetupCaption" FontSize="15" Foreground="{StaticResource Faint}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Style="{StaticResource TitleBtn}" Content="&#xE921;" Click="Min_Click" />
                    <Button Style="{StaticResource TitleBtn}" Content="&#xE8BB;" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24,4,24,14" Padding="30,26">
                <Grid>
                    <StackPanel x:Name="PageWelcome">
                        <TextBlock Text="Установка Zapret Launcher" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,14,0,0"
                                   Text="Мастер установит лаунчер, создаст ярлыки и сразу скачает компоненты zapret и прокси для Telegram. После этого обход блокировок включается одной кнопкой." />
                        <TextBlock FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0"
                                   Text="Удалить программу потом можно через «Установка и удаление программ» в параметрах Windows." />
                        <TextBlock x:Name="SetupVersion" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,22,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="PageOptions" Visibility="Collapsed">
                        <TextBlock Text="Куда установить" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SetupPath" Style="{StaticResource Field}" />
                            <Button Grid.Column="1" Content="Обзор…" Style="{StaticResource Pill}" Margin="8,0,0,0" Click="SetupBrowse_Click" />
                        </Grid>
                        <TextBlock x:Name="SetupPathError" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Text}" Margin="0,6,0,0" />
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" />
                        <CheckBox x:Name="SetupDesktop" Style="{StaticResource Switch}" IsChecked="True" Margin="0,16,0,16">
                            <StackPanel>
                                <TextBlock Text="Ярлык на рабочем столе" FontSize="14" Foreground="{StaticResource Text}" />
                                <TextBlock Text="В меню «Пуск» ярлык появится в любом случае" FontSize="12"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
                        <CheckBox x:Name="SetupAutostart" Style="{StaticResource Switch}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Запускать вместе с Windows" FontSize="14" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Включается сам, в трее и без запроса UAC" FontSize="12"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>

                    <StackPanel x:Name="PageWorking" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="SetupDoing" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock x:Name="SetupStatus" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,18" />
                        <ProgressBar x:Name="SetupBar" Height="3" Minimum="0" Maximum="100" BorderThickness="0"
                                     Background="#24FFFFFF" Foreground="{DynamicResource Signal}" />
                    </StackPanel>

                    <StackPanel x:Name="PageDone" Visibility="Collapsed">
                        <TextBlock x:Name="SetupDoneTitle" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock x:Name="SetupDoneText" FontSize="14" LineHeight="22" TextWrapping="Wrap"
                                   Foreground="{StaticResource Muted}" Margin="0,14,0,0" />
                        <CheckBox x:Name="SetupLaunch" Style="{StaticResource Switch}" IsChecked="True" Margin="0,24,0,0">
                            <TextBlock Text="Запустить Zapret Launcher" FontSize="14" Foreground="{StaticResource Text}" />
                        </CheckBox>
                    </StackPanel>

                    <StackPanel x:Name="PageRemove" Visibility="Collapsed">
                        <TextBlock Text="Удалить Zapret Launcher?" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,14,0,0"
                                   Text="Будут удалены лаунчер, ярлыки, автозапуск и скачанные компоненты: zapret и прокси для Telegram. Если обход или прокси сейчас включены, они остановятся." />
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" />
                        <CheckBox x:Name="SetupKeep" Style="{StaticResource Switch}" IsChecked="True" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Сохранить мои настройки" FontSize="14" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Стратегия, переключатели, списки *user*.txt и настройки прокси — на случай повторной установки"
                                           FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="24,0,24,20">
                <TextBlock x:Name="SetupStep" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SetupBack" Style="{StaticResource Pill}" Padding="18,8" Margin="0,0,8,0" Click="SetupBack_Click" />
                    <Button x:Name="SetupNext" Style="{StaticResource PillSolid}" Padding="18,8" Click="SetupNext_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Windows that open in the middle of the launcher, over everything but its title bar: the list of
             strategies, the proxy's instructions. Like the hint, the layer carries its own glass; code clips
             ModalFrost to the open panel. A click beside the panel, or Esc, closes it. -->
        <Grid x:Name="ModalLayer" Margin="0,44,0,0" Visibility="Collapsed" Opacity="0">
            <Rectangle Fill="#8C000000" MouseLeftButtonDown="ModalShade_Down" />
            <!-- the title bar is shaded with the rest, so it does not stand out as a frame, but stays in use -->
            <Rectangle Fill="#8C000000" Height="44" VerticalAlignment="Top" Margin="0,-44,0,0" IsHitTestVisible="False" />
            <Border x:Name="ModalShadow" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="16" Background="#000000"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.75" />
                </Border.Effect>
            </Border>
            <Grid x:Name="ModalFrost" IsHitTestVisible="False" Margin="0,-44,0,0">
                <Rectangle Fill="{StaticResource Space}" />
                <Grid x:Name="ModalSkyHost">
                    <Grid x:Name="ModalSky" />
                </Grid>
                <Grid x:Name="ModalWallpaper" Visibility="Collapsed">
                    <Grid x:Name="ModalWallpaperHost" Margin="-130">
                        <Rectangle x:Name="ModalWallpaperBox" />
                    </Grid>
                    <Rectangle x:Name="ModalWallpaperDim" />
                </Grid>
                <Rectangle Fill="{StaticResource Veil}" />
            </Grid>
            <Border x:Name="StrategyPanel" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,24"
                    CornerRadius="16" BorderBrush="{StaticResource Edge}" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="12,10,12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Стратегия обхода" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource Text}" />
                            <TextBlock Text="Если сайты не открываются, выберите другую" FontSize="12"
                                       HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="AutoButton" Content="Автоподбор" Style="{StaticResource Pill}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="Auto_Click" />
                    </Grid>

                    <ListBox x:Name="StrategyList" Grid.Row="1" Margin="6,0,6,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False" Padding="0"
                             TextOptions.TextHintingMode="Fixed"
                             PreviewMouseWheel="StrategyList_Wheel"
                             SelectionChanged="Strategy_Changed" />
                </Grid>
            </Border>
            <Border x:Name="ProxyInfoPanel" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"
                    CornerRadius="16" BorderBrush="{StaticResource Edge}" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="12,10,12,8">
                        <Button Content="Ссылка" Style="{StaticResource Pill}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Click="PxCopy_Click"
                                local:Hint.Text="Копирует ссылку вида tg://proxy… с адресом, портом и ключом этого прокси.&#x0a;&#x0a;Кому нужно: если кнопка «Подключить» не открыла Telegram.&#x0a;&#x0a;Что делать: отправьте ссылку себе в «Избранное» в Telegram и нажмите на неё." />
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Подключение Telegram" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource Text}" />
                            <TextBlock Text="Делается один раз" FontSize="12"
                                       HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="PxConnect" Content="Подключить" Style="{StaticResource Pill}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="PxConnect_Click"
                                local:Hint.Text="Открывает в Telegram на этом компьютере окно с предложением подключить прокси — останется подтвердить.&#x0a;&#x0a;Кому нужно: при первом включении прокси это происходит само. Кнопка — на случай, если окно закрыли или прокси пропал из настроек Telegram.&#x0a;&#x0a;Если Telegram после этого не соединяется, отключите в его настройках прокси «Попытку соединения по IPv6»." />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="34,6,34,16">
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="0,2,0,0" Background="#12FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <TextBlock Text="1" FontSize="13" Foreground="{StaticResource Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Включите прокси" FontSize="14" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Большой кнопкой посередине вкладки. Он работает прямо на этом компьютере" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="0,2,0,0" Background="#12FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <TextBlock Text="2" FontSize="13" Foreground="{StaticResource Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Подтвердите в Telegram" FontSize="14" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Telegram сам откроется с предложением подключить прокси. Не открылся — нажмите «Подключить» или возьмите ссылку" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="0,2,0,0" Background="#12FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <TextBlock Text="3" FontSize="13" Foreground="{StaticResource Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Готово" FontSize="14" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Дальше Telegram ходит через прокси сам, пока тот включён. Точка у названия вкладки показывает, что он работает" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Hint for the hovered button. It comes up in the middle of the window, over everything, so it
             carries its own piece of the same glass; code places it and clips HintFrost to its shape -->
        <Grid x:Name="HintLayer" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
            <Border x:Name="HintShadow" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="14" Background="#000000">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.7" />
                </Border.Effect>
            </Border>
            <Grid x:Name="HintFrost">
                <Rectangle Fill="{StaticResource Space}" />
                <Grid x:Name="HintSkyHost">
                    <Grid x:Name="HintSky" />
                </Grid>
                <Grid x:Name="HintWallpaper" Visibility="Collapsed">
                    <Grid x:Name="HintWallpaperHost" Margin="-130">
                        <Rectangle x:Name="HintWallpaperBox" />
                    </Grid>
                    <Rectangle x:Name="HintWallpaperDim" />
                </Grid>
                <Rectangle Fill="{StaticResource Veil}" />
            </Grid>
            <Border x:Name="HintBox" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="14"
                    BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="14,11" MaxWidth="330">
                <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                           Foreground="{StaticResource Text}" />
            </Border>
        </Grid>

        <!-- The pointer: drawn here, not by Windows, so it can trail the mouse (see the cursor code) -->
        <Canvas x:Name="CursorLayer" IsHitTestVisible="False" Opacity="0">
            <Grid Width="64" Height="64" Canvas.Left="-32" Canvas.Top="-32">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CursorAt" />
                </Grid.RenderTransform>
                <Ellipse RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="CursorGlowScale" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#99FFFFFF" Offset="0" />
                            <GradientStop Color="#5CFFFFFF" Offset="0.2" />
                            <GradientStop Color="#2BFFFFFF" Offset="0.42" />
                            <GradientStop Color="#0FFFFFFF" Offset="0.68" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="8" Height="8" Stroke="#33000000" StrokeThickness="1">
                    <Ellipse.Fill>
                        <SolidColorBrush x:Name="CursorFill" Color="#FFFFFF" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Canvas>
    </Grid>

</Window>
