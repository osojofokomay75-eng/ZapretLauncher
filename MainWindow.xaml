<Window x:Class="ZapretLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZapretLauncher"
        Title="Zapret Launcher" Width="1176" Height="780"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <!-- Palette: black sky, white for "on"; panels are frosted glass (see Frost below) -->
        <SolidColorBrush x:Key="Ink" Color="#0A0A0A" />
        <SolidColorBrush x:Key="Line" Color="#222222" />
        <SolidColorBrush x:Key="Text" Color="#F2F2F2" />
        <SolidColorBrush x:Key="Muted" Color="#9A9A9A" />
        <SolidColorBrush x:Key="Faint" Color="#6B6B6B" />
        <SolidColorBrush x:Key="Signal" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Edge" Color="#24FFFFFF" />

        <!-- Frosted panel: the blur itself is drawn by the Frost layer behind it -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="local:Glass.Radius" Value="16" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Invisible button laid over the power disc -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="local:Glass.Radius" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#52FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window buttons -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Strategy rows: selected row gets a signal bar on the left -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Padding="18,9,18,9" Margin="6,1,6,1" Background="Transparent">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="-16,0,0,0" Background="{StaticResource Signal}" Visibility="Hidden" />
                                <ContentPresenter HorizontalAlignment="Center" TextElement.FontSize="13.5" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hints for the list buttons -->
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="VerticalOffset" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="10"
                                Padding="14,11" MaxWidth="320">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                       Foreground="{StaticResource Text}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" Background="#2EFFFFFF">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#CFCFCF" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Signal}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#0A0A0A" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Shadow layer kept separate so the content text stays crisp -->
        <Border Margin="12" CornerRadius="18" Background="{StaticResource Ink}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" />
            </Border.Effect>
        </Border>

        <!-- Shell is clipped to the rounded window shape in code -->
        <Grid x:Name="Shell" Margin="12">
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.25" GradientOrigin="0.5,0.25" RadiusX="0.8" RadiusY="0.9">
                        <GradientStop Color="#121212" Offset="0" />
                        <GradientStop Color="#030303" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Drifting stars; the layers are filled in code -->
            <Grid x:Name="Sky" IsHitTestVisible="False" />

            <!-- Frosted glass: a blurred copy of the sky, clipped in code to every element with Glass.Radius -->
            <Grid x:Name="Frost" IsHitTestVisible="False">
                <Rectangle Fill="#0B0B0B" />
                <Grid x:Name="FrostSky">
                    <Grid.Effect>
                        <BlurEffect Radius="7" RenderingBias="Performance" />
                    </Grid.Effect>
                </Grid>
                <Rectangle Fill="#14FFFFFF" />
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid x:Name="TitleBar" Grid.Row="0" Height="44" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Zapret" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        <TextBlock Text=" Launcher" FontSize="15" Foreground="{StaticResource Faint}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Style="{StaticResource TitleBtn}" Content="&#xE921;" Click="Min_Click" />
                        <Button Style="{StaticResource TitleBtn}" Content="&#xE8BB;" Click="Close_Click" />
                    </StackPanel>
                </Grid>

                <!-- Power disc and status -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Grid Width="150" Height="150">
                        <Ellipse x:Name="Disc" Width="124" Height="124" local:Glass.Radius="999">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#0FFFFFFF" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="Ring" Width="124" Height="124" StrokeThickness="3">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="#6B6B6B" />
                            </Ellipse.Stroke>
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="GlowFx" Color="#6B6B6B" BlurRadius="40" ShadowDepth="0" Opacity="0" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Viewbox Width="46" Height="46" IsHitTestVisible="False">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="PowerIcon" Data="M18.36,6.64 A9,9 0 1 1 5.63,6.64 M12,2 L12,12"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Stroke>
                                        <SolidColorBrush Color="#9A9A9A" />
                                    </Path.Stroke>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <Button x:Name="PowerButton" Style="{StaticResource Ghost}" Width="124" Height="124"
                                Click="Power_Click" />
                    </Grid>

                    <TextBlock x:Name="StatusText" Text="Отключено" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{StaticResource Text}" />
                    <TextBlock x:Name="SubText" Text="Нажмите, чтобы включить" FontSize="13" MaxWidth="520"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{StaticResource Muted}" />
                </StackPanel>

                <!-- Strategy list, centred between the power button and the options -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Width="560" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="12,10,12,8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Стратегия обхода" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Если сайты не открываются, выберите другую" FontSize="12"
                                           HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="AutoButton" Content="Автоподбор" Style="{StaticResource Pill}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Auto_Click" />
                        </Grid>

                        <ListBox x:Name="StrategyList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 Margin="6,0,6,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False" Padding="0"
                                 PreviewMouseWheel="StrategyList_Wheel"
                                 SelectionChanged="Strategy_Changed" />
                    </Grid>
                </Border>

                <!-- Options and user lists -->
                <Grid Grid.Row="3" Margin="24,0,24,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="322" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="322" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,0">
                        <CheckBox x:Name="GameToggle" Style="{StaticResource Switch}" Click="Game_Click" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Игровой фильтр" FontSize="14" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Обход для игровых портов 1024–65535" FontSize="12"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,0">
                        <CheckBox x:Name="AutostartToggle" Style="{StaticResource Switch}" Click="Autostart_Click" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Запускать вместе с Windows" FontSize="14" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Включается сам, в трее и без запроса UAC" FontSize="12"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,8,12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Свои списки" FontSize="14" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Подсказка — при наведении" FontSize="12"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <UniformGrid Grid.Column="1" Columns="2" ToolTipService.InitialShowDelay="250"
                                         ToolTipService.ShowDuration="60000">
                                <Button Content="Мои сайты" Tag="list-general-user.txt" Style="{StaticResource Pill}"
                                        Padding="8,6" Margin="4" Click="UserList_Click"
                                        ToolTip="list-general-user.txt — сайты, которые нужно разблокировать дополнительно.&#x0a;&#x0a;Кому нужно: если сайт заблокирован и не открывается даже с включённым обходом.&#x0a;&#x0a;Что делать: впишите домены по одному в строке, например example.com — без https:// и без пути. Поддомены подхватятся сами. Не оставляйте файл пустым.&#x0a;&#x0a;После сохранения выключите и включите обход." />
                                <Button Content="Исключения" Tag="list-exclude-user.txt" Style="{StaticResource Pill}"
                                        Padding="8,6" Margin="4" Click="UserList_Click"
                                        ToolTip="list-exclude-user.txt — сайты, которые обход трогать не должен.&#x0a;&#x0a;Кому нужно: если с включённым обходом перестал работать обычный сайт или сервис — банк, игра, рабочий портал.&#x0a;&#x0a;Что делать: впишите домены по одному в строке, например example.com.&#x0a;&#x0a;После сохранения выключите и включите обход." />
                                <Button Content="Исключения IP" Tag="ipset-exclude-user.txt" Style="{StaticResource Pill}"
                                        Padding="8,6" Margin="4" Click="UserList_Click"
                                        ToolTip="ipset-exclude-user.txt — IP-адреса и подсети, которые обход трогать не должен.&#x0a;&#x0a;Кому нужно: опытным пользователям — когда ломается то, у чего нет доменного имени: игровой сервер, VPN, устройство в домашней сети.&#x0a;&#x0a;Что делать: впишите адреса по одному в строке, например 192.168.0.0/16 или 203.0.113.5.&#x0a;&#x0a;После сохранения выключите и включите обход." />
                                <Button Content="Папка lists" Style="{StaticResource Pill}"
                                        Padding="8,6" Margin="4" Click="ListsFolder_Click"
                                        ToolTip="Открывает папку со всеми списками zapret.&#x0a;&#x0a;Кому нужно: тем, кто хочет посмотреть, какие сайты и адреса уже входят в обход, или подложить готовый список.&#x0a;&#x0a;Важно: основные файлы (list-general.txt, ipset-all.txt и другие) перезаписываются при обновлении компонентов. Свои правки вносите только в файлы с user в названии — они сохраняются." />
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Footer -->
                <StackPanel Grid.Row="4" Margin="24,0,24,16">
                    <ProgressBar x:Name="DownloadBar" Height="3" Visibility="Collapsed" Minimum="0" Maximum="100"
                                 Background="#24FFFFFF" Foreground="{StaticResource Signal}" BorderThickness="0"
                                 Margin="0,0,0,10" />
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="820">
                            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="LogText" FontSize="12" Foreground="{StaticResource Muted}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="UpdateButton" Content="Обновить" Style="{StaticResource Pill}"
                                    Click="Update_Click" Margin="0,0,8,0" />
                            <Button Content="Папка" Style="{StaticResource Pill}" Click="Folder_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Margin="12" CornerRadius="18" BorderBrush="{StaticResource Edge}" BorderThickness="1" IsHitTestVisible="False" />
    </Grid>
</Window>
